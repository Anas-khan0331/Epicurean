# SMTP Configuration
# For development, create a test account at https://ethereal.email
# For production, use your real email service (Gmail, SendGrid, etc.)

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password

# Restaurant email (where all notifications are sent)
RESTAURANT_EMAIL=hello@epicurean.com

# Server port
PORT=3001
